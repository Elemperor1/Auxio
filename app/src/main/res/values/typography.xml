    Typography is now using the official brand font: Galano Grotesque.
    -->

    <!--
    Display styles are not used in Auxio.
    -->
    <style name="TextAppearance.Auxio.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/galano_grotesque_regular</item>
        <item name="android:fontFamily">@font/galano_grotesque_regular</item>
        <item name="android:textStyle">bold</item>
    </style>

